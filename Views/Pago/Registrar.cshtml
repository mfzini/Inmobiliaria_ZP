@model inmobiliaria.Models.Pago
@{
    ViewData["Title"] = "Registrar Pago";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-5">
        <div class="bg-body text-white p-4 rounded border border-secondary shadow" data-bs-theme="dark">
            <h3 class="text-center mb-4 text-white">Registrar Pago 💳</h3>

            <form asp-action="Registrar" method="post">
                
                <input type="hidden" name="reservaId" value="@ViewBag.ReservaId" />

                <div class="mb-3">
                    <label asp-for="Monto" class="form-label text-white">Monto: </label>
                    <input asp-for="Monto" type="number" step="0.01" class="form-control bg-dark text-white border-secondary" placeholder="0.00" required>
                    <span asp-validation-for="Monto" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label text-white">Concepto: </label>
                    <select asp-for="Concepto.Id" class="form-select bg-dark text-white border-secondary" required>
                        <option value="" disabled selected>Seleccione un concepto de pago</option>
                        @foreach (var c in ViewBag.Conceptos)
                        {
                            <option value="@c.Id">@c.Nombre</option>
                        }
                    </select>
                    <span asp-validation-for="Concepto.Id" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Fecha" class="form-label text-white">Fecha: </label>
                    <input asp-for="Fecha" type="date" class="form-control bg-dark text-white border-secondary" value="@DateTime.Now.ToString("yyyy-MM-dd")">
                    <span asp-validation-for="Fecha" class="text-danger"></span>
                </div>

                <div class="d-grid gap-2 mt-4">
                    <button type="submit" class="btn btn-dark border-secondary text-white">Registrar Pago 📝</button>
                    <a asp-controller="Reserva" asp-action="Detalles" asp-route-id="@ViewBag.ReservaId" class="btn btn-danger">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>