@model inmobiliaria.Models.Pago
@{
    ViewData["Title"] = "Editar Pago";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-5">
        <div class="bg-body text-white p-4 rounded border border-secondary shadow" data-bs-theme="dark">
            <h3 class="text-center mb-4 text-white">Editar Pago 💳</h3>

            <form asp-action="Editar" method="post">

                <input type="hidden" asp-for="Id" />

                <input type="hidden" asp-for="Reserva.Id" />
                
                <div class="mb-3">
                    <label asp-for="Monto" class="form-label text-white">Monto: </label>
                    <input asp-for="Monto" class="form-control bg-dark text-white border-secondary" readonly>
                </div>

                <div class="mb-3">
                    <label asp-for="Fecha" class="form-label text-white">Fecha: </label>
                    <input asp-for="Fecha" type="date" class="form-control bg-dark text-white border-secondary" readonly>
                </div>

                <div class="mb-3">
                    <label asp-for="Concepto" class="form-label text-white">Concepto: </label>
                    <select asp-for="Concepto" class="form-select bg-dark text-white border-secondary">
                        <option value="prueba">hola</option>
                    </select>
                    <span asp-validation-for="Concepto" class="text-danger"></span>
                </div>

                <div class="d-grid mt-4">
                    <button type="submit" class="btn btn-dark border-secondary text-white">Guardar Cambios 💾</button>
                </div>
            </form>
        </div>
    </div>
</div>