@model List<inmobiliaria.Models.TipoInmueble>
@{
    ViewData["Title"] = "Listar Tipos de Inmueble";
    var Pagina = ViewBag.Pagina ?? 1;
    var HaySiguiente = ViewBag.HaySiguiente ?? false;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Tipos de Inmueble: </h2>
        <a asp-action="Registrar" class="btn btn-primary">➕ Nuevo Tipo 🏢</a>
    </div>

    <table class="table table-dark table-hover">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th class="text-end">Acciones ⚙️</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in Model)
            {
                <tr>
                    <td>@t.Id</td>
                    <td>@t.Nombre</td>
                    <td class="text-end">
                        @if (User.IsInRole("Administrador"))
                        {
                        <a asp-action="Eliminar" asp-route-id="@t.Id" class="btn btn-sm btn-outline-danger">❌ Eliminar</a>
                        }
                    </td>
                </tr>
            }
            @if (Model.Count == 0)
            {
                <tr>
                    <td colspan="3" class="text-center text-white py-3">No se encontraron tipos de inmueble</td>
                </tr>
            }
        </tbody>
    </table>

    <nav aria-label="Page navigation" class="mt-4">
        <ul class="pagination justify-content-center">
            @if (Pagina > 1)
            {
                <li class="page-item">
                    <a class="page-link" href="~/TipoInmueble/Listar?pagina=@(Pagina - 1)" aria-label="Anterior">
                        Anterior
                    </a>
                </li>
            }
            else
            {
                <li class="page-item disabled">
                    <span class="page-link">Anterior</span>
                </li>
            }

            <li class="page-item active">
                <span class="page-link">@Pagina</span>
            </li>

            @if (HaySiguiente)
            {
                <li class="page-item">
                    <a class="page-link" href="~/TipoInmueble/Listar?pagina=@(Pagina + 1)" aria-label="Siguiente">
                        Siguiente
                    </a>
                </li>
            }
            else
            {
                <li class="page-item disabled">
                    <span class="page-link">Siguiente</span>
                </li>
            }
        </ul>
    </nav>


</div>