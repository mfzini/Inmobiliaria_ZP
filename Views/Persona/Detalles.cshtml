@model inmobiliaria.Models.Persona
@{
    ViewData["Title"] = "Detalles de la Persona";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="bg-body text-white p-4 rounded border border-secondary shadow" data-bs-theme="dark">
            <h3 class="text-center mb-4 text-white">Detalles de la Persona 👤</h3>

            <dl class="row">
                <dt class="col-sm-4 text-secondary">Dni:</dt>
                <dd class="col-sm-8">@Model.Dni</dd>

                <dt class="col-sm-4 text-secondary">Nombre:</dt>
                <dd class="col-sm-8">@Model.Nombre</dd>

                <dt class="col-sm-4 text-secondary">Apellido:</dt>
                <dd class="col-sm-8">@Model.Apellido </dd>

                <dt class="col-sm-4 text-secondary">Telefono:</dt>
                <dd class="col-sm-8">@Model.Telefono</dd>

                <dt class="col-sm-4 text-secondary">Email:</dt>
                <dd class="col-sm-8">@Model.Email</dd>

            </dl>

            <div class="d-flex justify-content-between mt-4">
                <a asp-action="Editar" asp-route-id="@Model.Dni" class="btn btn-primary">✏️ Editar</a>
                <a asp-action="Listar" class="btn btn-secondary">Volver al Listado</a>
            </div>
        </div>
    </div>
</div>