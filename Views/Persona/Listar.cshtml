@model List<inmobiliaria.Models.Persona>
@{
    ViewData["Title"] = "Listar Personas";
    var Pagina = ViewBag.Pagina ?? 1;
    var HaySiguiente = ViewBag.HaySiguiente ?? false;
}


<div class="container mt-4">

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Mensaje"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }



    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Listado de personas: </h2>
        <a asp-action="Registrar" class="btn btn-primary">➕ Registrar Persona 👤</a>
    </div>

    <table class="table table-dark table-hover">
        <thead>
            <tr>
                <th>DNI 📃</th>
                <th>Nombre</th>
                <th>Apellido</th>
                <th>Email ✉️</th>
                <th>Telefono 📞</th>
                <th class="text-end">Acciones ⚙️</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td>@p.Dni</td>
                    <td>@p.Nombre</td>
                    <td>@p.Apellido</td>
                    <td>@p.Email</td>
                    <td>@p.Telefono</td>
                    <td class="text-end">
                        <a asp-action="Editar" asp-route-id="@p.Dni" class="btn btn-sm btn-outline-light me-1">✏️ Editar</a>
                        @if (User.IsInRole("Administrador"))
                        {
                            <a asp-action="Eliminar" asp-route-id="@p.Dni" class="btn btn-sm btn-outline-danger">❌ Eliminar</a>
                        }
                        <a asp-action="Detalles" asp-route-id="@p.Dni" class="btn btn-sm btn-outline-info me-1">🔍 Detalles</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <nav aria-label="Page navigation" class="mt-4">
        <ul class="pagination justify-content-center">
            @if (Pagina > 1)
            {
                <li class="page-item">
                    <a class="page-link" href="~/Persona/Listar?pagina=@(Pagina - 1)" aria-label="Anterior">
                        Anterior
                    </a>
                </li>
            }
            else
            {
                <li class="page-item disabled">
                    <span class="page-link">Anterior</span>
                </li>
            }

            <li class="page-item active">
                <span class="page-link">@Pagina</span>
            </li>

            @if (HaySiguiente)
            {
                <li class="page-item">
                    <a class="page-link" href="~/Persona/Listar?pagina=@(Pagina + 1)" aria-label="Siguiente">
                        Siguiente
                    </a>
                </li>
            }
            else
            {
                <li class="page-item disabled">
                    <span class="page-link">Siguiente</span>
                </li>
            }
        </ul>
    </nav>

</div>