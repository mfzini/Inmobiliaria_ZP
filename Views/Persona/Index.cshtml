@model Persona
@{
    ViewData["Title"] = "Registrar Persona";
}

<div class="text-center">
    <form asp-action="Index" method="post">
        <label asp-for="Nombre">Nombre:</label>
        <input type="text" asp-for="Nombre" id="Nombre">

        <label asp-for="Apellido">Apellido:</label>
        <input type="text" asp-for="Apellido" id="Apellido">

        <label asp-for="Dni">DNI:</label>
        <input type="text" asp-for="Dni" id="Dni">

        <label asp-for="Email">Email:</label>
        <input type="email" asp-for="Email" id="Email">

        <label asp-for="Telefono">Telefono:</label>
        <input type="tel" asp-for="Telefono" id="Telefono">

        <button type="submit">Registrar</button>
    </form>
</div>
