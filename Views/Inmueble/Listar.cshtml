@model List<inmobiliaria.Models.Inmueble>
@{
    ViewData["Title"] = "Listar Inmuebles";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Listado de inmuebles: </h2>
        <a asp-action="Registrar" class="btn btn-primary">➕ Registrar Inmueble 🏠</a>
    </div>

    <table class="table table-dark table-hover">
        <thead>
            <tr>
                <th>Direccion 📍</th>
                <th>Propietario 👤</th>
                <th>Tipo 🏢</th>
                <th>Capacidad 👥</th>
                <th>Precio 💵</th>
                <th>Estado 📋</th>
                <th class="text-end">Acciones ⚙️</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var i in Model)
            {
                <tr>
                    <td>@i.Direccion</td>
                    <td>@i.Propietario.Nombre @i.Propietario.Apellido</td>
                    <td>@i.Tipo.Nombre</td>
                    <td>@i.Capacidad</td>
                    <td>$@i.Precio</td>
                    <td class="text-end">
                        <a asp-action="Editar" asp-route-id="@i.Id" class="btn btn-sm btn-outline-light me-1">✏️ Editar</a>
                        <a asp-action="Eliminar" asp-route-id="@i.Id" class="btn btn-sm btn-outline-danger">❌ Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>