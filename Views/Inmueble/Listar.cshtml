@model List<inmobiliaria.Models.Inmueble>
@{
    ViewData["Title"] = "Listar Inmuebles";
}

<div id="listado" class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Listado de inmuebles: </h2>
        <a asp-action="Registrar" class="btn btn-primary">➕ Registrar Inmueble 🏠</a>
    </div>


    <div class="row mb-3 justify-content-between align-items-center">
        <div class="col-md-5">
            <form v-on:submit.prevent="buscar" class="d-flex gap-2">
                <input type="text" 
                v-model="busqueda"
                :disabled="bloquear" 
                class="form-control" 
                placeholder="Buscar por direccion 🔍" />
                <button type="submit" class="btn btn-secondary">Buscar</button>
            </form>
        </div>
        <div class="col-auto d-flex gap-2 align-items-center">
            <select v-model="filtroSeleccionado" v-on:change="filtrar" class="form-select form-select-sm bg-dark text-white border-secondary">
                <option value="todos">Todos los inmuebles</option>
                <option value="disponibles">Solo disponibles</option>
                <option value="no_disponibles">No disponibles</option>
                <option value="mas_reservados">Mas reservados en ultimos 365 dias</option>
                <option value="sin_reservas">Sin reservas en ultimos X dias</option>
                <option value="disponibles_fechas">Disponibles entre fechas</option>
            </select>

            <span v-if="mostrarDias" class="text-black align-self-center">Dias:</span>
            <input v-if="mostrarDias" 
                type="number" 
                v-model="dias" 
                v-on:change="filtrar"
                placeholder="Dias"
                class="form-control form-control-sm w-auto bg-dark text-white border-secondary"/>

            <span v-if="mostrarFechas" class="text-black align-self-center">Desde:</span>
            <input v-if="mostrarFechas" type="date" v-model="desde" v-on:change="filtrar" class="form-control form-control-sm bg-dark text-white border-secondary w-auto"/>
            
            <span v-if="mostrarFechas" class="text-black align-self-center">Hasta:</span>
            <input v-if="mostrarFechas" type="date" v-model="hasta" v-on:change="filtrar" class="form-control form-control-sm bg-dark text-white border-secondary w-auto"/>

        </div>
    </div>


    <table class="table table-dark table-hover">
        <thead>
            <tr>
                <th>Direccion 📍</th>
                <th>Propietario 👤</th>
                <th>Tipo 🏢</th>
                <th>Capacidad 👥</th>
                <th>Precio 💵</th>
                <th>Reserva % 💳</th>
                <th>Estado 📋</th>
                <th class="text-end">Acciones ⚙️</th>
            </tr>
        </thead>
        <tbody>
            <tr v-for="i in lista" v-bind:key="i.id">
                <td>{{ i.direccion }}</td>
                <td>{{ i.propietario?.nombre }} {{ i.propietario?.apellido }} ({{ i.propietario?.dni }})</td>
                <td>{{ i.tipo?.nombre }}</td>
                <td>{{ i.capacidad }}</td>
                <td>${{ i.precio }}</td>
                <td>{{ i.porcentajeReserva }}%</td>
                <td>{{ i.listado }}</td>
                <td class="text-end">
                    <a :href="'/Inmueble/Editar/' + i.id" class="btn btn-sm btn-outline-light me-1">✏️ Editar</a>
                    <a :href="'/Inmueble/Eliminar/' + i.id" class="btn btn-sm btn-outline-danger me-1">❌ Eliminar</a>
                    <a :href="'/Inmueble/Detalles/' + i.id" class="btn btn-sm btn-outline-info me-1">🔍 Detalles</a>
                    <a :href="'/Inmueble/Fotos/' + i.id" class="btn btn-sm btn-outline-warning">📷 Fotos</a>
                </td>
            </tr>
            <tr v-if="lista.length === 0">
                <td colspan="8" class="text-center text-white py-3">No se encontraron inmuebles</td>
            </tr>
        </tbody>
    </table>
</div>

@section Scripts{
    <script>
        Vue.createApp({
            data(){
                return {
                    busqueda: '',
                    filtroSeleccionado: 'todos',
                    bloquear: false,
                    mostrarDias: false,
                    mostrarFechas: false,
                    dias: '',
                    desde: '',
                    hasta: '',
                    lista: []
                };
            },
            methods:{
                async buscar(){
                    try{
                        const res = await fetch(`/Inmueble/BuscarPorDireccion?direccion=${this.busqueda}`);
                        if(!res.ok) throw new Error();
                        const data = await res.json();
                        this.lista = data;
                    } catch(error){
                        console.error("Error buscando: ", error);
                    }
                },

                async filtrar(){
                    if(this.filtroSeleccionado == "todos"){
                        this.bloquear = false;
                    } else{
                        this.bloquear = true;
                        this.busqueda = '';
                    }

                    if(this.filtroSeleccionado == "sin_reservas"){
                        this.mostrarDias = true;
                        if(!this.dias) return;
                    } else{
                        this.mostrarDias = false
                    }

                    if(this.filtroSeleccionado == "disponibles_fechas"){
                        this.mostrarFechas = true;
                        if(!this.desde || !this.hasta) return;
                        const res = await fetch(`/Inmueble/ListarDisponiblesPorFechas?desde=${this.desde}&hasta=${this.hasta}`);
                        this.lista = await res.json();
                        return;
                    } else{
                        this.mostrarFechas = false;
                    }

                    const res = await fetch(`/Inmueble/FiltrarPorEstado?opcion=${this.filtroSeleccionado}&dias=${this.dias}`);
                    this.lista = await res.json();
                },

            },
            mounted(){
                this.buscar();
            }
        }).mount('#listado');
    </script>
}


