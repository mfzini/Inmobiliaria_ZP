@model List<inmobiliaria.Models.Inmueble>
@{
    ViewData["Title"] = "Listar Inmuebles";
}

<div id="listado" class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Listado de inmuebles: </h2>
        <div>
            <a asp-action="Busqueda" class="btn btn-primary me-2">➕ Busqueda Avanzada 🔍</a>
            <a asp-action="Registrar" class="btn btn-primary">➕ Registrar Inmueble 🏠</a>
        </div>
    </div>


    <div class="row mb-3 justify-content-between align-items-center">
        <div class="col-md-5">
            <form v-on:submit.prevent="alCambiarFiltro" class="d-flex gap-2">
                <input type="text" 
                v-model="busqueda"
                :disabled="bloquear" 
                class="form-control" 
                placeholder="Buscar por direccion 🔍" />
                <button type="submit" class="btn btn-secondary" :disabled="bloquear">Buscar</button>
            </form>
        </div>



        <div class="col-auto d-flex gap-2 align-items-center">
            <select v-model="filtroSeleccionado" v-on:change="alCambiarFiltro" class="form-select form-select-sm bg-dark text-white border-secondary">
                <option value="todos">Todos los inmuebles</option>
                <option value="disponibles">Solo disponibles</option>
                <option value="no_disponibles">No disponibles</option>
                <option value="mas_reservados">Mas reservados en ultimos 365 dias</option>
                <option value="sin_reservas">Sin reservas en ultimos X dias</option>
                <option value="disponibles_fechas">Disponibles entre fechas</option>
            </select>

            <span v-if="mostrarDias" class="text-black align-self-center">Dias:</span>
            <input v-if="mostrarDias" 
                type="number" 
                v-model="dias" 
                v-on:change="alCambiarFiltro"
                placeholder="Dias"
                class="form-control form-control-sm w-auto bg-dark text-white border-secondary"/>

            <span v-if="mostrarFechas" class="text-black align-self-center">Desde:</span>
            <input v-if="mostrarFechas" type="date" v-model="desde" v-on:change="alCambiarFiltro" class="form-control form-control-sm bg-dark text-white border-secondary w-auto"/>
            
            <span v-if="mostrarFechas" class="text-black align-self-center">Hasta:</span>
            <input v-if="mostrarFechas" type="date" v-model="hasta" v-on:change="alCambiarFiltro" class="form-control form-control-sm bg-dark text-white border-secondary w-auto"/>

        </div>
    </div>


    <table class="table table-dark table-hover">
        <thead>
            <tr>
                <th>Direccion 📍</th>
                <th>Propietario 👤</th>
                <th>Tipo 🏢</th>
                <th>Capacidad 👥</th>
                <th>Precio 💵</th>
                <th>Reserva % 💳</th>
                <th>Estado 📋</th>
                <th class="text-end">Acciones ⚙️</th>
            </tr>
        </thead>
        <tbody>
            <tr v-for="i in lista" v-bind:key="i.id">
                <td>{{ i.direccion }}</td>
                <td>{{ i.propietario?.nombre }} {{ i.propietario?.apellido }} ({{ i.propietario?.dni }})</td>
                <td>{{ i.tipo?.nombre }}</td>
                <td>{{ i.capacidad }}</td>
                <td>${{ i.precio }}</td>
                <td>{{ i.porcentajeReserva }}%</td>
                <td>{{ i.listado }}</td>
                <td class="text-end">
                    <a :href="'/Inmueble/Editar/' + i.id" class="btn btn-sm btn-outline-light me-1">✏️ Editar</a>
                    @if (User.IsInRole("Administrador"))
                    {
                        <a :href="'/Inmueble/Eliminar/' + i.id" class="btn btn-sm btn-outline-danger me-1">❌ Eliminar</a>
                    }
                    <a :href="'/Inmueble/Detalles/' + i.id" class="btn btn-sm btn-outline-info me-1">🔍 Detalles</a>
                    <a :href="'/Inmueble/Fotos/' + i.id" class="btn btn-sm btn-outline-warning">📷 Fotos</a>
                </td>
            </tr>
            <tr v-if="lista.length === 0">
                <td colspan="8" class="text-center text-white py-3">No se encontraron inmuebles</td>
            </tr>
        </tbody>
    </table>

    <nav aria-label="Page navigation" class="mt-4">
        <ul class="pagination">
            <li v-if="pagina > 1" class="page-item">
                <a class="page-link" href="#" v-on:click.prevent="cambiarPagina(pagina - 1)">Anterior</a>
            </li>
            <li v-else class="page-item disabled">
                <span class="page-link">Anterior</span>
            </li>

            <li class="page-item active">
                <span class="page-link">{{ pagina }}</span>
            </li>

            <li v-if="haySiguiente" class="page-item">
                <a class="page-link" href="#" v-on:click.prevent="cambiarPagina(pagina + 1)">Siguiente</a>
            </li>
            <li v-else class="page-item disabled">
                <span class="page-link">Siguiente</span>
            </li>
        </ul>
    </nav>


</div>

@section Scripts{
    <script>
        Vue.createApp({
            data(){
                return {
                    busqueda: '',
                    filtroSeleccionado: 'todos',
                    bloquear: false,
                    mostrarDias: false,
                    mostrarFechas: false,
                    dias: 30,
                    desde: '',
                    hasta: '',
                    lista: [],
                    pagina: 1,
                    haySiguiente: false
                };
            },
            methods:{
                async buscarTodos(pag = 1) {
                    this.pagina = pag;
                    const res = await fetch(`/Inmueble/ListarTodos?direccion=${this.busqueda}&pagina=${this.pagina}`);
                    this.lista = await res.json();
                    this.haySiguiente = (this.lista.length === 7);
                },

                async buscarPorDisponibilidad(pag = 1) {
                    this.pagina = pag;
                    const estado = (this.filtroSeleccionado === 'disponibles');
                    const res = await fetch(`/Inmueble/ListarPorDisponibilidad?disponible=${estado}&pagina=${this.pagina}`);
                    this.lista = await res.json();
                    this.haySiguiente = (this.lista.length === 7);
                },

                async buscarMasReservados(pag = 1) {
                    this.pagina = pag;
                    const res = await fetch(`/Inmueble/ListarMasReservados?pagina=${this.pagina}`);
                    this.lista = await res.json();
                    this.haySiguiente = (this.lista.length === 7);
                },

                async buscarSinReservas(pag = 1) {
                    if (!this.dias || this.dias <= 0) return;
                    this.pagina = pag;
                    const res = await fetch(`/Inmueble/ListarSinReservas?dias=${this.dias}&pagina=${this.pagina}`);
                    this.lista = await res.json();
                    this.haySiguiente = (this.lista.length === 7);
                },

                async buscarDisponiblesPorFechas(pag = 1) {
                    if (!this.desde || !this.hasta) return;
                    this.pagina = pag;
                    const res = await fetch(`/Inmueble/ListarDisponiblesPorFechas?desde=${this.desde}&hasta=${this.hasta}&pagina=${this.pagina}`);
                    this.lista = await res.json();
                    this.haySiguiente = (this.lista.length === 7);
                },

                ejecutarFiltro(pag = 1) {
                    if (this.filtroSeleccionado === 'todos') {
                        this.buscarTodos(pag);
                    } else if (this.filtroSeleccionado === 'disponibles' || this.filtroSeleccionado === 'no_disponibles') {
                        this.buscarPorDisponibilidad(pag);
                    } else if (this.filtroSeleccionado === 'mas_reservados') {
                        this.buscarMasReservados(pag);
                    } else if (this.filtroSeleccionado === 'sin_reservas') {
                        this.buscarSinReservas(pag);
                    } else if (this.filtroSeleccionado === 'disponibles_fechas') {
                        this.buscarDisponiblesPorFechas(pag);
                    }
                },

                alCambiarFiltro() {
                    this.bloquear = (this.filtroSeleccionado !== 'todos');
                    this.mostrarDias = (this.filtroSeleccionado === 'sin_reservas');
                    this.mostrarFechas = (this.filtroSeleccionado === 'disponibles_fechas');
                    this.ejecutarFiltro(1);
                },

                cambiarPagina(nuevaPag) {
                    this.ejecutarFiltro(nuevaPag);
                }

            },
            mounted(){
                this.buscarTodos(1);
            }
        }).mount('#listado');
    </script>
}


