@model inmobiliaria.DTO.InmuebleDTO
@{
    ViewData["Title"] = "Editar Inmueble";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-5">
        <div class="bg-body text-white p-4 rounded border border-secondary shadow" data-bs-theme="dark">
            <h3 class="text-center mb-4 text-white">Editar Inmueble</h3>

            <form asp-action="Editar" method="post" id="edicionInmueble">
                <input type="hidden" name="id" value="@ViewBag.InmuebleId"/>

                <div class="mb-3">
                    <label asp-for="Propietario" class="form-label text-white">Propietario: </label>
                    <input id="buscadorPropietario" 
                        class="form-control bg-dark text-white border-secondary"
                        placeholder="Escribi para buscar propietario" 
                        v-model="busquedaPropietario" 
                        @@input="buscarPropietarios">
                    <select name="Propietario" class="form-select bg-dark text-white border-secondary">
                        <option value="@Model.Propietario" selected>@ViewBag.TextoPropietario</option>
                        <option v-for="persona in personas" :key="persona.dni" :value="persona.dni">
                            ({{ persona.dni }}) {{ persona.nombre }} {{ persona.apellido }}
                        </option>
                    </select>
                    <span asp-validation-for="Propietario" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label text-white">Tipo de Inmueble: </label>
                    <input id="buscadorTipo" 
                        class="form-control bg-dark text-white border-secondary"
                        placeholder="Escribi para buscar tipo"
                        v-model="busquedaTipo"
                        @@input="buscarTipos">
                    <select name="Tipo" class="form-select bg-dark text-white border-secondary">
                        <option value="@Model.Tipo" selected>@ViewBag.TextoTipo</option>
                        <option v-for="t in tipos" :key="t.id" :value="t.id">
                            {{ t.nombre }}
                        </option>
                    </select>
                    <span asp-validation-for="Tipo" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Direccion" class="form-label text-white">Direccion: </label>
                    <input asp-for="Direccion" class="form-control bg-dark text-white border-secondary">
                    <span asp-validation-for="Direccion" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Capacidad" class="form-label text-white">Capacidad: </label>
                    <input asp-for="Capacidad" type="number" class="form-control bg-dark text-white border-secondary">
                    <span asp-validation-for="Capacidad" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Precio" class="form-label text-white">Precio: </label>
                    <input asp-for="Precio" type="number" step="0.01" class="form-control bg-dark text-white border-secondary">
                    <span asp-validation-for="Precio" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Latitud" class="form-label text-white">Latitud: </label>
                    <input asp-for="Latitud" class="form-control bg-dark text-white border-secondary">
                </div>

                <div class="mb-3">
                    <label asp-for="Longitud" class="form-label text-white">Longitud: </label>
                    <input asp-for="Longitud" class="form-control bg-dark text-white border-secondary">
                </div>

                <div class="mb-3">
                    <input asp-for="Listado" type="checkbox" class="form-check-input bg-dark border-secondary" />
                    <label asp-for="Listado" class="form-check-label text-white">Disponible?</label>
                </div>

                <div class="d-grid gap-2 mt-4">
                    <button type="submit" class="btn btn-primary border-secondary text-white">Guardar 📝</button>
                    <a asp-action="Listar" class="btn btn-danger">Cancelar ✖️</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        Vue.createApp({
            data(){
                return {
                    busquedaPropietario: '',
                    personas: [],
                    timerPropietario: null,

                    busquedaTipo: '',
                    tipos: [],
                    timerTipo: null
                };
            },
            methods:{
                buscarPropietarios(){
                    clearTimeout(this.timerPropietario); 
                    this.timerPropietario = setTimeout(async () => {
                        let nombreBuscado = this.busquedaPropietario.trim();
                        if(nombreBuscado.length >= 2){
                            try {
                                this.personas = await fetch(`/Persona/BuscarNombre?nombreBuscado=${nombreBuscado}`)
                                    .then(r => r.json());
                            } catch (e) {
                                console.error("error buscando personas:", e);
                            }
                        } else {
                            this.personas = [];
                        }
                    }, 300);
                },
                buscarTipos(){
                    clearTimeout(this.timerTipo); 
                    this.timerTipo = setTimeout(async () => {
                        let tipoBuscado = this.busquedaTipo.trim();
                        if(tipoBuscado.length >= 2){
                            try {
                                this.tipos = await fetch(`/TipoInmueble/BuscarTipo?tipoBuscado=${tipoBuscado}`)
                                    .then(r => r.json());
                            } catch (e) {
                                console.error("error buscando tipos de inmuebles:", e);
                            }
                        } else {
                            this.tipos = [];
                        }
                    }, 300);
                }
            }
        }).mount('#edicionInmueble');
    </script>
}