@model inmobiliaria.DTO.InmuebleDTO
@{
    ViewData["Title"] = "Registrar Inmueble";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-5">
        <div class="bg-body text-white p-4 rounded border border-secondary shadow" data-bs-theme="dark">
            <h3 class="text-center mb-4 text-white">Registrar Inmueble</h3>

            <form asp-action="Registrar" method="post" id="registroInmueble">
                <div class="mb-3">
                    <label asp-for="Propietario" class="form-label text-white">Propietario: </label>
                    <input id="buscadorPropietario" list="options"
                    class="form-control bg-dark text-white border-secondary"
                    placeholder="Escribi para buscar propietario" 
                    v-model="busquedaPropietario" 
                    @@input="buscarPropietarios">
                <datalist id="options">
                    <option value="" disabled selected>Elegi un propietario</option>
                        <option v-for="persona in personas" :key="persona.dni" :value="persona.dni">
                            {{ persona.nombre }} {{ persona.apellido }} ({{ persona.dni }})
                        </option>
                </datalist>
                    <span asp-validation-for="Propietario" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label class="form-label text-white">Tipo de Inmueble: </label>
                    <input asp-for="Tipo" class="form-control bg-dark text-white border-secondary">
                    <span asp-validation-for="Tipo" class="text-danger"></span>
                    
                </div>

                <div class="mb-3">
                    <label class="form-label text-white">Direccion: </label>
                    <input asp-for="Direccion" type="text" class="form-control bg-dark text-white border-secondary">
                    <span asp-validation-for="Direccion" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label text-white">Capacidad: </label>
                    <input asp-for="Capacidad" type="number" class="form-control bg-dark text-white border-secondary">
                    <span asp-validation-for="Capacidad" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label text-white">Precio: </label>
                    <input asp-for="Precio" type="number" class="form-control bg-dark text-white border-secondary">
                    <span asp-validation-for="Precio" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label text-white">Latitud: </label>
                    <input asp-for="Latitud" type="text" class="form-control bg-dark text-white border-secondary">
                    <span asp-validation-for="Latitud" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label text-white">Longitud: </label>
                    <input asp-for="Longitud" type="text" class="form-control bg-dark text-white border-secondary">
                    <span asp-validation-for="Longitud" class="text-danger"></span>
                </div>

                <div class="mb-3 form-check">
                    <input asp-for="Listado" type="checkbox" class="form-check-input bg-dark border-secondary">
                    <label asp-for="Listado" class="form-check-label text-white">Esta disponible?</label>
                    <span asp-validation-for="Listado" class="text-danger"></span>
                </div>

                <div class="d-grid mt-4">
                    <button type="submit" class="btn btn-dark border-secondary text-white">Registrar 📝</button>
                </div>
            </form>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        Vue.createApp({
            data(){
                return {
                    busquedaPropietario: '',
                    personas: [],
                    timer: null
                };
            },
            methods:{
                buscarPropietarios(){
                    clearTimeout(this.timer); 
                    this.timer = setTimeout(async () => {
                        let nombreBuscado = this.busquedaPropietario.trim();
                        if(nombreBuscado.length >= 2){
                            try {
                                this.personas = await fetch(`/Persona/BuscarNombre/?nombreBuscado=${nombreBuscado}`)
                                .then(r => r.json());
                            } catch (e) {
                                console.error("error buscando personas:", e);
                            }
                        } else {
                            this.personas = [];
                        }
                    }, 300);
                }
            }
        }).mount('#registroInmueble');
    </script>
}