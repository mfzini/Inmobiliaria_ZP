@{
    ViewData["Title"] = "Búsqueda Avanzada";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-7">
        <div class="bg-body text-white p-4 rounded border border-secondary shadow" data-bs-theme="dark">
            <h3 class="text-center mb-4 text-white">Búsqueda Avanzada de Inmuebles 🔍</h3>

            <form asp-action="BusquedaAvanzada" method="get" class="mb-4">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label text-white">Fecha Inicio: </label>
                        <input type="date" name="fechaInicio" class="form-control bg-dark text-white border-secondary">
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label text-white">Fecha Fin: </label>
                        <input type="date" name="fechaFin" class="form-control bg-dark text-white border-secondary">
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label text-white">Capacidad Minima: </label>
                        <input type="number" name="capacidad" class="form-control bg-dark text-white border-secondary" placeholder="Ej: 2">
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label text-white">Tipo de Inmueble: </label>
                        <select name="tipo" class="form-select bg-dark text-white border-secondary">
                            <option value="1">Departamento</option>
                            <option value="2">Casa</option>
                            <option value="3">Local Comercial</option>
                        </select>
                    </div>
                </div>

                <div class="d-grid mt-2">
                    <button type="submit" class="btn btn-primary">Buscar Inmuebles Libres 🔎</button>
                </div>
            </form>

            <hr class="border-secondary my-4" />

            <h5 class="mb-3 text-white">Inmuebles Adecuados Encontrados:</h5>
            <table class="table table-dark table-striped align-middle">
                <thead>
                    <tr>
                        <th>Dirección📍</th>
                        <th>Capacidad👥</th>
                        <th>Precio💵</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Av. Mitre 450</td>
                        <td>2 personas</td>
                        <td>$45.000</td>
                    </tr>
                    <tr>
                        <td>Pedernera 820</td>
                        <td>4 personas</td>
                        <td>$60.000</td>
                    </tr>
                    <tr>
                        <td>Lavalle 1100</td>
                        <td>3 personas</td>
                        <td>$35.000</td>
                    </tr>
                </tbody>
            </table>

            <div class="d-flex justify-content-end mt-3">
                <a asp-controller="Reserva" asp-action="Listar" class="btn btn-secondary">Volver</a>
            </div>
        </div>
    </div>
</div>