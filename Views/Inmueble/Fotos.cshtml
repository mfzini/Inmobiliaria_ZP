@model inmobiliaria.Models.Inmueble

<div id="appFotos" class="container mt-4 text-dark">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom border-2 border-dark">
        <h1 class="m-0 text-dark">Fotos de: @Model.Direccion</h4>
        <a asp-action="Index" class="btn btn-secondary px-3">Volver</a>
    </div>

    <div class="row">
        <!-- seccion portada -->
        <div class="col-md-5 pe-md-4 border-end border-2 border-dark">
            <h3 class="mb-3 text-dark">Portada</h3>

            <div class="mb-3">
                <img v-if="urlPortada" v-bind:src="urlPortada" class="img-fluid rounded border shadow-sm w-100"
                    alt="portada">
                <div v-else class="text-center border rounded py-4 text-muted bg-light">
                    No hay foto de portada
                </div>
            </div>

            <form v-on:submit.prevent="subirPortada">
                <input type="file" ref="filePortada" class="form-control form-control-sm mb-2" accept="image/*" />
                <button type="submit" class="btn btn-primary btn-sm" v-bind:disabled="cargandoPortada">
                    <span v-if="cargandoPortada">Guardando</span>
                    <span v-else>Guardar Portada</span>
                </button>
            </form>
        </div>

        <!-- seccion fotos interior -->
        <div class="col-md-7 ps-md-4">
            <h3 class="mb-3 text-dark">Fotos del Interior</h3>

            <form v-on:submit.prevent="subirGaleria" class="mb-3">
                <input type="file" ref="fileGaleria" v-on:change="previsualizar" class="form-control form-control-sm mb-2"
                    accept="image/*" multiple />

                <div class="d-flex flex-wrap gap-2 mb-2">
                    <img v-for="img in vistasPrevias" v-bind:src="img" width="80" height="60" class="rounded border">
                </div>

                <button type="submit" class="btn btn-success btn-sm" v-bind:disabled="cargandoGaleria">Subir
                    Fotos</button>
                </form>

                <h5 class="text-secondary mt-3">Fotos Actuales:</h5>
                <div class="row g-2 mt-2">
                    <div v-for="foto in galeria" v-bind:key="foto.id" class="col-auto">
                        <div class="bg-dark p-2 rounded text-center">
                            <img v-bind:src="foto.url" width="120" height="90" class="rounded d-block mb-2">
                            <div class="card-body p-1">
                                <button type="button" v-on:click="eliminarFoto(foto.id)"
                                class="btn btn-danger btn-sm w-100 py-0">Borrar</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @section Scripts {
        <script>
            Vue.createApp({
                data() {
                    return {
                        inmuebleId: "@Model.Id",
                        urlPortada: "@Model.Portada",
                        galeria: [],
                        vistasPrevias: [],
                        cargandoPortada: false,
                        cargandoGaleria: false

                    };
                },
                methods: {
                    async subirPortada() {
                        const input = this.$refs.filePortada;
                        if (!input.files || input.files.length == 0) {
                            alert("selecciona una foto para la portada");
                            return;
                        }

                        const formData = new FormData();
                        formData.append("portadaFile", input.files[0]);

                        this.cargandoPortada = true;

                        try {
                            const res = await fetch(`/Imagenes/CambiarPortada?id=${this.inmuebleId}`, {
                                method: 'POST',
                                body: formData
                            });

                            if (!res.ok) throw new Error();

                            const data = await res.json();
                            this.urlPortada = data.url;
                            input.value = "";
                            alert("se subio la portada correctamente");

                        } catch (error) {
                            console.error(error);
                            alert("error subiendo la portada");
                        } finally {
                            this.cargandoPortada = false;
                        }
                    },

                    previsualizar(event) {
                        this.vistasPrevias = [];
                        const files = event.target.files;
                        if (!files) return;

                        [...files].forEach(file => {
                            const reader = new FileReader();
                            reader.onload = (e) => {
                                this.vistasPrevias.push(e.target.result);
                            };
                            reader.readAsDataURL(file);
                        });
                    },

                    async subirGaleria() {
                        const input = this.$refs.fileGaleria;
                        if (!input.files || input.files.length == 0) {
                            alert("selecciona al menos una imagen");
                            return;
                        }

                        const formData = new FormData();
                        for (let i = 0; i < input.files.length; i++) {
                            formData.append("imagenes", input.files[i]);
                        }

                        this.cargandoGaleria = true;

                        try {
                            const res = await fetch(`/Imagenes/Alta?id=${this.inmuebleId}`, {
                                method: "POST",
                                body: formData,
                            });

                            this.galeria = await res.json();

                            this.vistasPrevias = [];
                            input.value = "";
                        } catch (error) {
                            console.error(error);
                            alert("error subiendo las imagenes");
                        } finally {
                            this.cargandoGaleria = false;
                        }
                    },


                    async eliminarFoto(imagenId) {
                        try {
                            const res = await fetch(`/Imagenes/Eliminar?id=${imagenId}`, {
                                method: "POST"
                            });

                            if (!res.ok) throw new Error();

                            this.galeria = this.galeria.filter(foto => foto.id !== imagenId);
                            alert("imagen eliminada con exito");
                        } catch (error) {
                            console.error(error);
                            alert("error eliminando la imagen");
                        }
                    },

                    async cargarFotos(){
                        try{
                            const res= await fetch(`/Imagenes/TraerFotos?id=${this.inmuebleId}`);
                            if(res.ok){
                                let data = await res.json();
                                this.galeria = data.imagenes || [];
                                this.urlPortada = data.portada ? data.portada.url : null;
                            } 
                        } catch(error){
                            console.error(error);
                            alert("error cargando las fotos");
                        }
                    }
                },
                mounted(){
                    this.cargarFotos();
                }
            }).mount('#appFotos');
        </script>
    }

