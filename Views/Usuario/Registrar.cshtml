@{
    ViewData["Title"] = "Registrar Empleado";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-5">
        <div class="bg-body text-white p-4 rounded border border-secondary shadow" data-bs-theme="dark">
            <h3 class="text-center mb-4 text-white">Registrar Empleado 👤</h3>

            <form asp-action="Registrar" method="post">
                
                <div class="mb-3">
                    <label class="form-label text-white">Nombre: </label>
                    <input type="text" name="nombre" class="form-control bg-dark text-white border-secondary" placeholder="" required>
                </div>

                <div class="mb-3">
                    <label class="form-label text-white">Apellido: </label>
                    <input type="text" name="apellido" class="form-control bg-dark text-white border-secondary" placeholder="" required>
                </div>

                <div class="mb-3">
                    <label class="form-label text-white">Contrasena: </label>
                    <input type="password" name="password" class="form-control bg-dark text-white border-secondary" placeholder="" required>
                </div>

                <div class="mb-3">
                    <label class="form-label text-white">Avatar / Foto: </label>
                    <input type="file" name="avatar" class="form-control bg-dark text-white border-secondary" accept="image/*">
                </div>

                <div class="d-grid mt-4">
                    <button type="submit" class="btn btn-dark border-secondary text-white">Registrar 📝</button>
                </div>
            </form>
        </div>
    </div>
</div>