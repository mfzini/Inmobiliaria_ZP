@model List<inmobiliaria.Models.Log>
@{
    ViewData["Title"] = "Historial de Logs";

    var Pagina = ViewBag.Pagina ?? 1;
    var HaySiguiente = ViewBag.HaySiguiente ?? false;
    var Dni = ViewBag.Dni as string;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Historial de logs del Usuario: </h2>
    </div>

    <table class="table table-dark table-hover">
        <thead>
            <tr>
                <th>Usuario 👤</th>
                <th>Fecha 📅</th>
                <th class="text-end">Acción realizada </th>
            </tr>
        </thead>
        <tbody>
            @foreach (Log item in Model)
            {
                <tr>
                    <td>@item.Usuario.Nombre</td>
                    <td>@item.CreatedAt.ToString("dd/MM/yyyy")</td>
                    <td class="text-end">@item.Entry</td>
                </tr>
            }
            @if(Model.Count == 0){
                <tr>
                    <td colspan="3" class="text-center text-white py-3">No se encontraron Logs</td>
                </tr>
            }
        </tbody>
    </table>

    <nav aria-label="Page navigation" class="mt-4">
        <ul class="pagination justify-content-center">
            @if (Pagina > 1)
            {
                <li class="page-item">
                    <a class="page-link" href="~/Usuario/LogsUsuario?dni=@Dni&pagina=@(Pagina - 1)" aria-label="Anterior">
                        Anterior
                    </a>
                </li>
            }
            else
            {
                <li class="page-item disabled">
                    <span class="page-link">Anterior</span>
                </li>
            }

            <li class="page-item active">
                <span class="page-link">@Pagina</span>
            </li>

            @if (HaySiguiente)
            {
                <li class="page-item">
                    <a class="page-link" href="~/Usuario/LogsUsuario?dni=@Dni&pagina=@(Pagina + 1)" aria-label="Siguiente">
                        Siguiente
                    </a>
                </li>
            }
            else
            {
                <li class="page-item disabled">
                    <span class="page-link">Siguiente</span>
                </li>
            }
        </ul>
    </nav>


</div>

