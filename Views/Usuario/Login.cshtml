@{
    ViewData["Title"] = "Iniciar Sesión";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-4">
        <div class="bg-body text-white p-4 rounded border border-secondary shadow" data-bs-theme="dark">
            <h3 class="text-center mb-4 text-white">Iniciar Sesión 🔐</h3>

            <form asp-action="Login" method="post">

                <div class="mb-3">
                    <label class="form-label text-white">Email / Usuario: </label>
                    <input type="email" name="email" class="form-control bg-dark text-white border-secondary" placeholder="usuario@correo.com" required>
                </div>


                <div class="mb-3">
                    <label class="form-label text-white">Contrasena: </label>
                    <input type="password" name="password" class="form-control bg-dark text-white border-secondary" placeholder="••••••••" required>
                </div>

                <div class="d-grid mt-4">
                    <button type="submit" class="btn btn-dark border-secondary text-white">Ingresar 🚀</button>
                </div>
            </form>
        </div>
    </div>
</div>