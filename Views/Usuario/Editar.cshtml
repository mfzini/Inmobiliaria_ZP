@model dynamic
@{
    ViewData["Title"] = "Editar Empleado";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-5">
        <div class="bg-body text-white p-4 rounded border border-secondary shadow" data-bs-theme="dark">
            <h3 class="text-center mb-4 text-white">Editar Empleado 👤</h3>

            <form asp-action="Editar" method="post">
                
                <input type="hidden" name="id" value="@Model.Id" />

                <div class="mb-3">
                    <label class="form-label text-white">Nombre: </label>
                    <input type="text" name="nombre" class="form-control bg-dark text-white border-secondary" value="@Model.Nombre" required>
                </div>

                <div class="mb-3">
                    <label class="form-label text-white">Apellido: </label>
                    <input type="text" name="apellido" class="form-control bg-dark text-white border-secondary" value="@Model.Apellido" required>
                </div>

                <div class="mb-3">
                    <label class="form-label text-white">Nueva Contrasena (opcional): </label>
                    <input type="password" name="password" class="form-control bg-dark text-white border-secondary" placeholder="Dejar en blanco para mantener la actual">
                </div>

                <div class="mb-3">
                    <label class="form-label text-white">Cambiar Avatar: </label>
                    <input type="file" name="avatar" class="form-control bg-dark text-white border-secondary" accept="image/*">
                </div>

                <div class="d-grid mt-4">
                    <button type="submit" class="btn btn-primary text-white">Guardar Cambios 💾</button>
                    <a asp-controller="Reserva" asp-action="Listar" class="btn btn-link text-secondary mt-2 text-decoration-none text-center">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>