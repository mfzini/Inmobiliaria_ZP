@model List<inmobiliaria.Models.Usuario>
@{
    ViewData["Title"] = "Listado de Empleados";
    var Pagina = ViewBag.Pagina ?? 1;
    var HaySiguiente = ViewBag.HaySiguiente ?? false;
}

<div class="row justify-content-center mt-4">
    <div class="col-md-9">
        <div class="bg-body text-white p-4 rounded border border-secondary shadow" data-bs-theme="dark">
            
            @if (TempData["Mensaje"] != null)
            {
                <div class="alert alert-info alert-dismissible fade show mb-4" role="alert">
                    @TempData["Mensaje"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="d-flex justify-content-between align-items-center mb-4">
                <h3 class="m-0 text-white">Listado de Empleados 👥</h3>
                <div class="d-flex gap-2">
                    <a asp-action="Logs" class="btn btn-outline-info btn-sm">📋 Ver Logs Usuarios</a>
                    <a asp-action="Registrar" class="btn btn-success btn-sm">➕ Nuevo Empleado</a>
                </div>
            </div>

            <table class="table table-dark table-striped align-middle">
                <thead>
                    <tr>
                        <th>Avatar👤</th>
                        <th>Nombre y Apellido📝</th>
                        <th>Email✉️</th>
                        <th>Rol🛡️</th>
                        <th class="text-end">Acciones⚙️</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var usuario in Model)
                    {
                        <tr>
                            <td>
                                @if (usuario.Avatar != null)
                                {
                                    <img src="@usuario.Avatar.Url" class="rounded-circle border border-secondary object-fit-cover" width="40" height="40" alt="Avatar" />
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Sin foto</span>
                                }
                            </td>
                            <td>@usuario.Nombre @usuario.Apellido</td>
                            <td>@usuario.Email</td>
                            <td>@usuario.Role</td>
                            <td class="text-end">
                                <a asp-action="Editar" asp-route-id="@usuario.Dni" class="btn btn-outline-light btn-sm me-1">✏️ Editar</a>
                                <a asp-action="Eliminar" asp-route-id="@usuario.Dni" class="btn btn-outline-danger btn-sm">❌ Eliminar</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <nav aria-label="Page navigation" class="mt-4">
                <ul class="pagination justify-content-center">
                    @if (Pagina > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" href="~/Usuario/Listar?pagina=@(Pagina - 1)" aria-label="Anterior">
                                Anterior
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="page-item disabled">
                            <span class="page-link">Anterior</span>
                        </li>
                    }

                    <li class="page-item active">
                        <span class="page-link">@Pagina</span>
                    </li>

                    @if (HaySiguiente)
                    {
                        <li class="page-item">
                            <a class="page-link" href="~/Usuario/Listar?pagina=@(Pagina + 1)" aria-label="Siguiente">
                                Siguiente
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="page-item disabled">
                            <span class="page-link">Siguiente</span>
                        </li>
                    }
                </ul>
            </nav>




        </div>
    </div>
</div>