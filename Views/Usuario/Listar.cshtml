@{
    ViewData["Title"] = "Listado de Empleados";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-9">
        <div class="bg-body text-white p-4 rounded border border-secondary shadow" data-bs-theme="dark">
            
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h3 class="m-0 text-white">Listado de Empleados 👥</h3>
                <a asp-action="Registrar" class="btn btn-success btn-sm">➕ Nuevo Empleado</a>
            </div>

            <table class="table table-dark table-striped align-middle">
                <thead>
                    <tr>
                        <th>Avatar👤</th>
                        <th>Nombre y Apellido📝</th>
                        <th>Email✉️</th>
                        <th class="text-end">Acciones⚙️</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>
                            <img src="aca foto" class="rounded-circle border border-secondary" width="40" height="40" alt="Avatar" />
                        </td>
                        <td>Lucas Rodriguez</td>
                        <td>lucas@inmobiliaria.com</td>
                        <td class="text-end">
                            <a asp-action="Editar" asp-route-id="1" class="btn btn-outline-light btn-sm me-1">✏️ Editar</a>
                            <a asp-action="Eliminar" asp-route-id="1" class="btn btn-outline-danger btn-sm">🗑️ Borrar</a>
                        </td>
                    </tr>

                    <tr>
                        <td>
                            <img src="avatar" class="rounded-circle border border-secondary" width="40" height="40" alt="Avatar" />
                        </td>
                        <td>Mariana Gomez</td>
                        <td>mariana@inmobiliaria.com</td>
                        <td class="text-end">
                            <a asp-action="Editar" asp-route-id="2" class="btn btn-outline-light btn-sm me-1">✏️ Editar</a>
                            <a asp-action="Eliminar" asp-route-id="2" class="btn btn-outline-danger btn-sm">🗑️ Borrar</a>
                        </td>
                    </tr>
                </tbody>
            </table>

            <div class="d-flex justify-content-end mt-3">
                <a asp-controller="Reserva" asp-action="Listar" class="btn btn-secondary">Volver al Panel</a>
            </div>
        </div>
    </div>
</div>