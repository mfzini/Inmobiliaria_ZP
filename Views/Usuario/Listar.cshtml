@model List<inmobiliaria.Models.Usuario>
@{
    ViewData["Title"] = "Listado de Empleados";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-9">
        <div class="bg-body text-white p-4 rounded border border-secondary shadow" data-bs-theme="dark">
            
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h3 class="m-0 text-white">Listado de Empleados 👥</h3>
                <a asp-action="Registrar" class="btn btn-success btn-sm">➕ Nuevo Empleado</a>
            </div>

            <table class="table table-dark table-striped align-middle">
                <thead>
                    <tr>
                        <th>Avatar👤</th>
                        <th>Nombre y Apellido📝</th>
                        <th>Email✉️</th>
                        <th>Rol🛡️</th>
                        <th class="text-end">Acciones⚙️</th>
                    </tr>
                </thead>
                @foreach (var usuario in Model)
                    {
                        <tr>
                            <td>
                                @if (usuario.Avatar != null)
                                {
                                    <img src="@usuario.Avatar.Url" class="rounded-circle border border-secondary object-fit-cover" width="40" height="40" alt="Avatar" />
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Sin foto</span>
                                }
                            </td>
                            <td>@usuario.Nombre @usuario.Apellido</td>
                            <td>@usuario.Email</td>
                            <td>@usuario.Role</td>
                            <td class="text-end">
                                <a asp-action="Editar" asp-route-id="@usuario.Dni" class="btn btn-outline-light btn-sm me-1">✏️ Editar</a>
                                <a asp-action="Eliminar" asp-route-id="@usuario.Dni" class="btn btn-outline-danger btn-sm">❌ Eliminar</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>