@model inmobiliaria.Models.Reserva
@{
    ViewData["Title"] = "Extender Reserva";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-5">
        <div class="bg-body text-white p-4 rounded border border-secondary shadow" data-bs-theme="dark">
            <h3 class="text-center mb-4 text-white">Extender Reserva 📅</h3>

            <form asp-action="Extender" method="post">
                <input type="hidden" name="idAnterior" value="@Model.Id" />
                <input type="hidden" name="Inmueble" value="@Model.Inmueble.Id" />
                <input type="hidden" name="Inquilino" value="@Model.Inquilino.Dni" />
                <input type="hidden" asp-for="FechaInicio" value="@Model.FechaInicio.ToString("yyyy-MM-dd")" />

                <div class="mb-3">
                    <label class="form-label text-white">Inmueble: </label>
                    <input type="text" class="form-control bg-dark text-white border-secondary" 
                        value="@Model.Inmueble.Direccion" readonly>
                </div>

                <div class="mb-3">
                    <label class="form-label text-white">Inquilino: </label>
                    <input type="text" class="form-control bg-dark text-white border-secondary" 
                        value="@Model.Inquilino.Nombre @Model.Inquilino.Apellido (@Model.Inquilino.Dni)" readonly>
                </div>

                <div class="mb-3">
                    <label class="form-label text-white">Fecha de Inicio: </label>
                    <input type="text" class="form-control bg-dark text-white border-secondary" 
                        value="@Model.FechaInicio.ToString("dd/MM/yyyy")" readonly>
                </div>

                <div class="mb-3">
                    <label asp-for="FechaFin" class="form-label text-white">Nueva Fecha de Fin: </label>
                    <input asp-for="FechaFin" type="date" min="@Model.FechaInicio.ToString("yyyy-MM-dd")" class="form-control bg-dark text-white border-secondary" required>
                    <span asp-validation-for="FechaFin" class="text-danger"></span>
                </div>

                <div class="d-grid mt-4">
                    <button type="submit" class="btn btn-warning text-dark fw-bold">Guardar Extension 💾</button>
                    <a asp-action="Detalles" asp-route-id="@Model.Id" class="btn btn-link text-secondary mt-2 text-decoration-none text-center">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>