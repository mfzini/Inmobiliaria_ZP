@model List<inmobiliaria.Models.Reserva>
@{
    ViewData["Title"] = "Listar Reservas";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Listado de reservas: </h2>
        <a asp-action="Registrar" class="btn btn-primary">➕ Registrar Reserva 📅</a>
    </div>

    <table class="table table-dark table-hover">
        <thead>
            <tr>
                <th>Inmueble 🏠</th>
                <th>Inquilino 👤</th>
                <th>Fecha Inicio 🗓️</th>
                <th>Fecha Fin 🗓️</th>
                <th class="text-end">Acciones ⚙️</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td>@r.Inmueble.Direccion</td>
                    <td>@r.Inquilino.Nombre @r.Inquilino.Apellido</td>
                    <td>@r.FechaInicio.ToString("dd-MM-yyyy")</td>
                    <td>@r.FechaFin.ToString("dd-MM-yyyy")</td>
                    <td class="text-end">
                        <a asp-action="Editar" asp-route-id="@r.Id" class="btn btn-sm btn-outline-light me-1">✏️ Editar</a>
                        <a asp-action="Eliminar" asp-route-id="@r.Id" class="btn btn-sm btn-outline-danger">❌ Eliminar</a>
                        <a asp-action="Detalles" asp-route-id="@r.Id" class="btn btn-sm btn-outline-info me-1">🔍 Detalles</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>