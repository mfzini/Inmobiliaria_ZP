@model List<inmobiliaria.Models.Reserva>
@{
    ViewData["Title"] = "Listar Reservas";
}

<div id="listadoReservas" class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Listado de reservas: </h2>
        <a asp-action="Registrar" class="btn btn-primary">➕ Registrar Reserva 📅</a>
    </div>

    <div class="d-flex justify-content-end gap-2 mb-3">
        <select v-model="filtro" v-on:change="cambiarFiltro" class="form-select form-select-sm bg-dark text-white border-secondary w-auto">
            <option value="todas">Todas</option>
            <option value="vigentes">Vigentes por fecha</option>
            <option value="terminan_en">Terminan en X dias</option>
        </select>

        <!--inputs para vigentes-->
        <span v-if="filtro == 'vigentes'" class="text-black align-self-center">Desde:</span>
        <input v-if="filtro == 'vigentes'" type="date" v-model="desde" v-on:change="filtrar(1)" class="form-control form-control-sm bg-dark text-white border-secondary w-auto" />
        
        <span v-if="filtro == 'vigentes'" class="text-black align-self-center">Hasta:</span>
        <input v-if="filtro == 'vigentes'" type="date" v-model="hasta" v-on:change="filtrar(1)" class="form-control form-control-sm bg-dark text-white border-secondary w-auto" />
    
        <!-- input para terminan en x dias -->
        <span v-if="filtro == 'terminan_en'" class="text-black align-self-center">Dias:</span>
        <input v-if="filtro == 'terminan_en'" type="number" v-model="dias" v-on:change="filtrar(1)" placeholder="Cantidad de dias" class="form-control form-control-sm bg-dark text-white border-secondary w-auto" />

    </div>

    <table class="table table-dark table-hover">
        <thead>
            <tr>
                <th>Inmueble 🏠</th>
                <th>Inquilino 👤</th>
                <th>Fecha Inicio 🗓️</th>
                <th>Fecha Fin 🗓️</th>
                <th class="text-end">Acciones ⚙️</th>
            </tr>
        </thead>
        <tbody>
                <tr v-for="r in lista">
                    <td>{{r.inmueble?.direccion}}</td>
                    <td>{{r.inquilino?.nombre }} {{r.inquilino?.apellido }} ({{r.inquilino?.dni }})</td>
                    <td>{{new Date(r.fechaInicio).toLocaleDateString()}}</td>
                    <td>{{new Date(r.fechaFin).toLocaleDateString()}}</td>
                    <td class="text-end">
                        <a :href="'/Reserva/Editar/' + r.id" class="btn btn-sm btn-outline-light me-1">✏️ Editar</a>
                        @if (User.IsInRole("Administrador"))
                        {
                            <a :href="'/Reserva/Eliminar/' + r.id" class="btn btn-sm btn-outline-danger">❌ Eliminar</a>
                        }
                        <a :href="'/Reserva/Detalles/' + r.id" class="btn btn-sm btn-outline-info me-1">🔍 Detalles</a>
                    </td>
                </tr>
                <tr v-if="lista.length === 0">
                    <td colspan="5" class="text-center text-white py-3">No se encontraron Reservas</td>
                </tr>
        </tbody>
    </table>

    <nav aria-label="Page navigation" class="mt-4">
        <ul class="pagination">
            <li v-if="pagina > 1" class="page-item">
                <a class="page-link" href="#" v-on:click.prevent="irPagina(pagina - 1)">Anterior</a>
            </li>
            <li v-else class="page-item disabled">
                <span class="page-link">Anterior</span>
            </li>

            <li class="page-item active">
                <span class="page-link">{{ pagina }}</span>
            </li>

            <li v-if="haySiguiente" class="page-item">
                <a class="page-link" href="#" v-on:click.prevent="irPagina(pagina + 1)">Siguiente</a>
            </li>
            <li v-else class="page-item disabled">
                <span class="page-link">Siguiente</span>
            </li>
        </ul>
    </nav>



</div>



@section Scripts{
    <script>
        Vue.createApp({
            data(){
                return {
                    filtro: 'todas',
                    desde: '',
                    hasta: '',
                    dias: '',
                    lista: [],
                    pagina: 1,           
                    haySiguiente: false
                };
            },
            methods:{
                irPagina(pag){
                    if(this.filtro === 'todas'){
                        this.cargarTodas(pag);
                    } else {
                        this.filtrar(pag);
                    }
                },



                async cargarTodas(pag = 1){
                    this.pagina = pag;
                    const res = await fetch('/Reserva/ListarTodas?pagina=${this.pagina}');
                    this.lista = await res.json();
                    this.haySiguiente = this.lista.length === 7;
                },

                cambiarFiltro() {
                    this.desde = '';
                    this.hasta = '';
                    this.dias = '';
                    if(this.filtro == "todas"){
                        this.cargarTodas(1);
                    }
                },

                async filtrar(pag = 1) {
                    this.pagina = pag;
                    if (this.filtro == "vigentes" && this.desde && this.hasta) {
                        const res = await fetch(`/Reserva/ListarVigentes?desde=${this.desde}&hasta=${this.hasta}&pagina=${this.pagina}`);
                        this.lista = await res.json();
                    } else if (this.filtro == "terminan_en" && this.dias) {
                        const res = await fetch(`/Reserva/ListarPorTerminar?dias=${this.dias}&pagina=${this.pagina}`);
                        this.lista = await res.json();
                        this.haySiguiente = this.lista.length === 7;
                    }
                },

            },
            mounted(){
                this.cargarTodas(1);
            }
        }).mount('#listadoReservas');
    </script>
}
