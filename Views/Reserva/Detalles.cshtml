@model inmobiliaria.Models.Reserva
@{
    ViewData["Title"] = "Detalles de la Reserva";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-8">
        <div class="bg-body text-white p-4 rounded border border-secondary shadow" data-bs-theme="dark">
            <h3 class="text-center mb-4 text-white">Detalles de Reserva</h3>

            <dl class="row">
                <dt class="col-sm-4 text-secondary">ID Reserva:</dt>
                <dd class="col-sm-8">@Model.Id</dd>

                <dt class="col-sm-4 text-secondary">Inmueble:</dt>
                <dd class="col-sm-8">@Model.Inmueble.Direccion</dd>

                <dt class="col-sm-4 text-secondary">Inquilino:</dt>
                <dd class="col-sm-8">@Model.Inquilino.Nombre @Model.Inquilino.Apellido (DNI: @Model.Inquilino.Dni)</dd>

                <dt class="col-sm-4 text-secondary">Fecha Inicio:</dt>
                <dd class="col-sm-8">@Model.FechaInicio.ToString("dd-MM-yyyy")</dd>

                <dt class="col-sm-4 text-secondary">Fecha Fin:</dt>
                <dd class="col-sm-8">@Model.FechaFin.ToString("dd-MM-yyyy")</dd>
            </dl>

            <div class="d-flex justify-content-between align-items-center mt-4 mb-3">
                <h4 class="m-0">Pagos Vinculados 💳</h4>
                <a asp-controller="Pago" asp-action="Registrar" asp-route-reservaId="@Model.Id" class="btn btn-success btn-sm">➕ Cargar Pago</a>
            </div>

            <table class="table table-dark table-striped">
                <thead>
                    <tr>
                        <th>Fecha📅</th>
                        <th>Concepto📃</th>
                        <th>Monto💵</th>
                        <th>Estado🔃</th>
                        <th class="text-end">Acciones⚙️</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Pagos)
                    {
                        <tr>
                            <td>@p.Fecha.ToString("dd/MM/yyyy")</td>
                            <td>@p.Concepto?.Nombre</td>
                            <td>$@p.Monto</td>
                            <td>@p.Anulado</td>
                            <td class="text-end">
                                <a asp-controller="Pago" asp-action="Editar" asp-route-id="@p.Id" class="btn btn-outline-light btn-sm me-1">✏️ Editar</a>
                                <a asp-controller="Pago" asp-action="Anular" asp-route-id="@p.Id" class="btn btn-outline-danger btn-sm">🔃 Cambiar estado</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>


            <div class="d-flex justify-content-between mt-4">
                <a asp-action="Editar" asp-route-id="@Model.Id" class="btn btn-primary">✏️ Editar</a>
                <a asp-action="Extender" asp-route-id="@Model.Id" class="btn btn-warning">📅 Extender Reserva</a>
                <a asp-action="Listar" class="btn btn-secondary">Volver al Listado</a>
            </div>
        </div>
    </div>
</div>