@model inmobiliaria.DTO.ReservaDTO
@{
    ViewData["Title"] = "Editar Reserva";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-5">
        <div class="bg-body text-white p-4 rounded border border-secondary shadow" data-bs-theme="dark">
            <h3 class="text-center mb-4 text-white">Editar Reserva</h3>

            <form asp-action="Editar" method="post">
                <input type="hidden" name="id" value="@ViewBag.ReservaId"/>

                <div class="mb-3">
                    <label asp-for="Inmueble" class="form-label text-white">Inmueble: </label>
                    <input asp-for="Inmueble" class="form-control bg-dark text-white border-secondary"/>
                    <span asp-validation-for="Inmueble" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Inquilino" class="form-label text-white">Inquilino: </label>
                    <input asp-for="Inquilino" class="form-control bg-dark text-white border-secondary"/>
                    <span asp-validation-for="Inquilino" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="FechaInicio" class="form-label text-white">Fecha de Inicio: </label>
                    <input asp-for="FechaInicio" type="date" class="form-control bg-dark text-white border-secondary">
                    <span asp-validation-for="FechaInicio" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="FechaFin" class="form-label text-white">Fecha de Fin: </label>
                    <input asp-for="FechaFin" type="date" class="form-control bg-dark text-white border-secondary">
                    <span asp-validation-for="FechaFin" class="text-danger"></span>
                </div>

                <div class="d-grid gap-2 mt-4">
                    <button type="submit" class="btn btn-primary border-secondary text-white">Guardar 📝</button>
                    <a asp-action="Listar" class="btn btn-danger">Cancelar ✖️</a>
                </div>
            </form>
        </div>
    </div>
</div>