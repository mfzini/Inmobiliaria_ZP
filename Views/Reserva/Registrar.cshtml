@model inmobiliaria.DTO.ReservaDTO
@{
    ViewData["Title"] = "Registrar Reserva";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-5">
        <div class="bg-body text-white p-4 rounded border border-secondary shadow" data-bs-theme="dark">
            <h3 class="text-center mb-4 text-white">Registrar Reserva</h3>

            <form asp-action="Registrar" method="post" id="registroReserva">
                <div class="mb-3">
                    <label asp-for="Inmueble" class="form-label text-white">Inmueble: </label>
                    <input type="hidden" asp-for="Inmueble" v-model="inmuebleId" />
                    <input id="buscadorInmueble" 
                        list="opcionesInmueble"
                        class="form-control bg-dark text-white border-secondary"
                        placeholder="Escribi direccion para buscar" 
                        v-model="busquedaInmueble"
                        autocomplete="off" 
                        @@input="buscarInmuebles"
                        @@change="rellenarInmueble">
                    <datalist id="opcionesInmueble">
                        <option v-for="inm in inmuebles" :key="inm.id" :value="inm.direccion">
                        </option>
                    </datalist>
                    <span asp-validation-for="Inmueble" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Inquilino" class="form-label text-white">Inquilino: </label>
                    <input type="hidden" asp-for="Inquilino" v-model="inquilinoId" />
                    <input id="buscadorInquilino" 
                        list="opcionesInquilino"
                        class="form-control bg-dark text-white border-secondary"
                        placeholder="Escribi para buscar inquilino" 
                        v-model="busquedaInquilino"
                        autocomplete="off" 
                        @@input="buscarInquilinos"
                        @@change="rellenarInquilino">
                    <datalist id="opcionesInquilino">
                        <option v-for="persona in inquilinos" :key="persona.dni" 
                        :value="persona.nombre + ' ' + persona.apellido + '(' + persona.dni + ')'">
                        </option>
                    </datalist>
                    <span asp-validation-for="Inquilino" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="FechaInicio" class="form-label text-white">Fecha de Inicio: </label>
                    <input asp-for="FechaInicio" type="date" v-model="fechaInicio" class="form-control bg-dark text-white border-secondary">
                    <span asp-validation-for="FechaInicio" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="FechaFin" class="form-label text-white">Fecha de Fin: </label>
                    <input asp-for="FechaFin" type="date" v-model="fechaFin" class="form-control bg-dark text-white border-secondary">
                    <span asp-validation-for="FechaFin" class="text-danger"></span>
                </div>

                <div class="d-grid mt-4">
                    <button type="button" class="btn btn-warning fw-bold text-dark" @@click="calcularYMostrarModal">
                        Calcular Primer Pago 💵
                    </button>
                </div>

                <div class="modal fade" id="myModal" tabindex="-1">
                    <div class="modal-dialog">
                        <div class="modal-content text-dark">
                            <div class="modal-header text-white">
                                <h5 class="modal-title">Confirmar Seña</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body text-center text-white">
                                <p>El porcentaje del alquiler que pide es este:</p>
                                <h3 class="text-success fw-bold">${{ montoCalculado }}</h3>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                <button type="submit" class="btn btn-primary">Aceptar y Pagar</button>
                            </div>
                        </div>
                    </div>
                </div>


            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        Vue.createApp({
            data(){
                return {
                    inmuebleId: '',
                    busquedaInmueble: '',
                    inmuebles: [],
                    timerInmueble: null,

                    inquilinoId: '',
                    busquedaInquilino: '',
                    inquilinos: [],
                    timerInquilino: null,
                    fechaInicio: '',
                    fechaFin: '',
                    montoCalculado: 0
                };
            },
            methods:{


                calcularYMostrarModal(){
                    if(!this.inmuebleId || !this.fechaInicio || !this.fechaFin){
                        alert("Te falta completar el inmueble y elegir las fechas de la reserva");
                        return;
                    }

                    fetch(`/Reserva/CalcularPorcentajeInicial?idInmueble=${this.inmuebleId}&fechaInicio=${this.fechaInicio}&fechaFin=${this.fechaFin}`)
                        .then(res => res.json())
                        .then(data => {
                            this.montoCalculado = data;
                            const myModal = new bootstrap.Modal('#myModal');
                            myModal.show();
                        }).catch(err => {
                            console.error(err);
                            alert("Error: " + err.message);
                        });;
                },




                buscarInmuebles(){
                    this.rellenarInmueble();
                    if (this.inmuebleId) {
                        return;
                    }
                    clearTimeout(this.timerInmueble); 
                    this.timerInmueble = setTimeout(async () => {
                        let direccionBuscada = this.busquedaInmueble.trim();
                        if(direccionBuscada.length >= 2){
                            try {
                                this.inmuebles = await fetch(`/Reserva/BuscarDireccion?direccionBuscada=${direccionBuscada}`)
                                    .then(r => r.json());
                            } catch (e) {
                                console.error("Error buscando inmuebles:", e);
                            }
                        } else {
                            this.inmuebles = [];
                        }
                    }, 300);
                },

                rellenarInmueble(){
                    this.inmuebleId = '';
                    for (let inm of this.inmuebles) {
                        if (this.busquedaInmueble == inm.direccion) {
                            this.inmuebleId = inm.id;
                        }
                    }
                },

                buscarInquilinos(){
                    this.rellenarInquilino();
                    if (this.inquilinoId) {
                        return;
                    }
                    clearTimeout(this.timerInquilino); 
                    this.timerInquilino = setTimeout(async () => {
                        let nombreBuscado = this.busquedaInquilino.trim();
                        if(nombreBuscado.length >= 2){
                            try {
                                this.inquilinos = await fetch(`/Persona/BuscarNombre?nombreBuscado=${nombreBuscado}`)
                                    .then(r => r.json());
                            } catch (e) {
                                console.error("Error buscando inquilinos:", e);
                            }
                        } else {
                            this.inquilinos = [];
                        }
                    }, 300);
                },

                rellenarInquilino(){
                    this.inquilinoId = '';
                    for (let p of this.inquilinos) {
                        if (this.busquedaInquilino.includes(p.dni)) {
                            this.inquilinoId = p.dni;
                        }
                    }
                }
            }
        }).mount('#registroReserva');
</script>
}




