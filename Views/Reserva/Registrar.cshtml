@model inmobiliaria.DTO.ReservaDTO
@{
    ViewData["Title"] = "Registrar Reserva";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-5">
        <div class="bg-body text-white p-4 rounded border border-secondary shadow" data-bs-theme="dark">
            <h3 class="text-center mb-4 text-white">Registrar Reserva</h3>

            <form asp-action="Registrar" method="post" id="registroReserva">
                <div class="mb-3">
                    <label asp-for="Inmueble" class="form-label text-white">Inmueble: </label>
                    <input id="buscadorInmueble" 
                        list="opcionesInmueble"
                        name="Inmueble"
                        class="form-control bg-dark text-white border-secondary"
                        placeholder="Escribi direccion para buscar" 
                        v-model="busquedaInmueble" 
                        @@input="buscarInmuebles">
                    <datalist id="opcionesInmueble">
                        <option v-for="inm in inmuebles" :key="inm.id" :value="inm.id">
                            {{ inm.direccion }} (Precio: ${{ inm.precio }})
                        </option>
                    </datalist>
                    <span asp-validation-for="Inmueble" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Inquilino" class="form-label text-white">Inquilino: </label>
                    <input id="buscadorInquilino" 
                        list="opcionesInquilino"
                        name="Inquilino"
                        class="form-control bg-dark text-white border-secondary"
                        placeholder="Escribi para buscar inquilino" 
                        v-model="busquedaInquilino" 
                        @@input="buscarInquilinos">
                    <datalist id="opcionesInquilino">
                        <option v-for="persona in inquilinos" :key="persona.dni" :value="persona.dni">
                            {{ persona.nombre }} {{ persona.apellido }} ({{ persona.dni }})
                        </option>
                    </datalist>
                    <span asp-validation-for="Inquilino" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="FechaInicio" class="form-label text-white">Fecha de Inicio: </label>
                    <input asp-for="FechaInicio" type="date" class="form-control bg-dark text-white border-secondary">
                    <span asp-validation-for="FechaInicio" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="FechaFin" class="form-label text-white">Fecha de Fin: </label>
                    <input asp-for="FechaFin" type="date" class="form-control bg-dark text-white border-secondary">
                    <span asp-validation-for="FechaFin" class="text-danger"></span>
                </div>

                <div class="d-grid mt-4">
                    <button type="submit" class="btn btn-dark border-secondary text-white">Registrar 📝</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        Vue.createApp({
            data(){
                return {
                    busquedaInmueble: '',
                    inmuebles: [],
                    timerInmueble: null,

                    busquedaInquilino: '',
                    inquilinos: [],
                    timerInquilino: null
                };
            },
            methods:{
                buscarInmuebles(){
                    clearTimeout(this.timerInmueble); 
                    this.timerInmueble = setTimeout(async () => {
                        let direccionBuscada = this.busquedaInmueble.trim();
                        if(direccionBuscada.length >= 2){
                            try {
                                this.inmuebles = await fetch(`/Reserva/BuscarDireccion?direccionBuscada=${direccionBuscada}`)
                                    .then(r => r.json());
                            } catch (e) {
                                console.error("Error buscando inmuebles:", e);
                            }
                        } else {
                            this.inmuebles = [];
                        }
                    }, 300);
                },
                buscarInquilinos(){
                    clearTimeout(this.timerInquilino); 
                    this.timerInquilino = setTimeout(async () => {
                        let nombreBuscado = this.busquedaInquilino.trim();
                        if(nombreBuscado.length >= 2){
                            try {
                                this.inquilinos = await fetch(`/Persona/BuscarNombre?nombreBuscado=${nombreBuscado}`)
                                    .then(r => r.json());
                            } catch (e) {
                                console.error("Error buscando inquilinos:", e);
                            }
                        } else {
                            this.inquilinos = [];
                        }
                    }, 300);
                }
            }
        }).mount('#registroReserva');
    </script>
}




