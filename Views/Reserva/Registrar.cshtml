@model inmobiliaria.Models.Reserva
@{
    ViewData["Title"] = "Registrar Reserva";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-5">
        <div class="bg-black text-white p-4 rounded border border-secondary">
            <h3 class="text-center mb-4 text-white">Registrar Reserva</h3>

            <form asp-action="Registrar" method="post">
                <div class="mb-3">
                    <label class="form-label text-white">Inmueble: </label>
                    <select class="form-select bg-dark text-white border-secondary">
                        <option value="">Seleccione un inmueble</option>
                        <option value="1">Av. San Martin 123 (Casa)</option>
                        <option value="2">Belgrano 456 (Departamento)</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label text-white">Inquilino: </label>
                    <select class="form-select bg-dark text-white border-secondary">
                        <option value="">Seleccione un inquilino</option>
                        <option value="1">Carlos Lopez</option>
                        <option value="2">Ana Fernandez</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label text-white">Fecha de Inicio: </label>
                    <input type="date" class="form-control bg-dark text-white border-secondary">
                </div>

                <div class="mb-3">
                    <label class="form-label text-white">Fecha de Fin: </label>
                    <input type="date" class="form-control bg-dark text-white border-secondary">
                </div>

                <div class="d-grid mt-4">
                    <button type="submit" class="btn btn-dark border-secondary text-white">Registrar 📝</button>
                </div>
            </form>
        </div>
    </div>
</div>